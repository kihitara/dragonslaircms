# Headers for the files Workers Assets serves (CSS, JS, icons).
#
# Workers Assets answers before src/index.js runs, so the header pass in the
# Worker (src/csp.js) never sees these requests. Without this file they would
# carry none of the protections every rendered page carries.
#
# The Content-Security-Policy is deliberately not here: a page's policy carries
# a per-request nonce that only the Worker can mint.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
