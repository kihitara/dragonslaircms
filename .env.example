# Credentials for the Wrangler CLI (used by `npm run dev/deploy` and the db:*
# scripts). Copy to .env and fill in — .env is gitignored, never commit it.
#
# Create an API token at https://dash.cloudflare.com/profile/api-tokens with the
# "Edit Cloudflare Workers" template (plus D1 and R2 edit permissions).
CLOUDFLARE_API_TOKEN=
# Your account ID (Cloudflare dashboard → Workers & Pages → right sidebar).
CLOUDFLARE_ACCOUNT_ID=
