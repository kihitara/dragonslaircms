{
	// The Worker's name. `npm run setup` sets this for you; change it here if you
	// want a different name (it becomes part of the *.workers.dev URL).
	"name": "dragonslaircms",
	"main": "src/index.js",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Static assets served from /public — CSS, JS, bundled icons.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	// D1 (SQLite) database. No database_id is committed on purpose: the Deploy to
	// Cloudflare button and `wrangler deploy` (v4.45+) auto-provision the database
	// and write the id back here, and `npm run setup` creates it explicitly. Only
	// paste an id yourself if you disabled auto-provisioning.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dragonslaircms"
		}
	],
	// R2 bucket for uploaded media — auto-provisioned the same way as the database.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "dragonslaircms"
		}
	],
	// Outgoing email (optional). Needs a domain onboarded to Cloudflare Email
	// Routing (Workers Paid). On the Free plan / no domain, leave this as-is and
	// turn "Send outgoing email" OFF in Admin → Settings — the CMS then uses
	// in-app notifications only.
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// Cron Trigger for scheduled publishing (available on the Workers Free plan).
	// Runs the scheduled() handler in src/index.js — every 15 minutes here.
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
	// No "vars" block is needed: the site title, tagline, canonical URL and email
	// "From" address are all set in Admin → Settings and stored in the database.
	// (You may still add a "vars" block with SITE_TITLE / SITE_TAGLINE / SITE_URL
	// / SITE_EMAIL_FROM as fallbacks used before those settings are saved.)
	//
	// Secrets (set by `npm run setup`, or manually via `wrangler secret put`):
	//   ADMIN_SESSION_SECRET  - random 32+ char string for signing admin sessions
	//   READER_SESSION_SECRET - random 32+ char string for signing reader sessions
}
