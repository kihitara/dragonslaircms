{
  "name": "dragonslaircms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "wrangler dev",
    "deploy": "npm run db:schema:remote && wrangler deploy",
    "db:schema": "wrangler d1 execute DB --file=schema.sql --local --yes",
    "db:schema:remote": "wrangler d1 execute DB --file=schema.sql --remote --yes"
  },
  "devDependencies": {
    "wrangler": "^4.106.0"
  }
}
